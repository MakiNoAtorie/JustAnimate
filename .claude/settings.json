{
  "permissions": {
    "deny": [
      "mcp__1a59c906-04da-521d-bda7-7f71b9f9e01c__*",
      "mcp__visualize__*",
      "mcp__Claude_Browser__*",
      "mcp__claude-in-chrome__*",
      "Artifact",
      "SearchPlugins",
      "SuggestPluginInstall",
      "SuggestSkills"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-kill-by-name.sh\""
          }
        ]
      }
    ]
  }
}