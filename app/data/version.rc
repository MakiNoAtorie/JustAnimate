// Windows resources for JustAnimate: application icon and version info.
//
// app/app.cmake defines, when compiling this file:
//   RC_APP_VERSION      comma-separated version, e.g. 0,0,0,0
//   RC_APP_VERSION_STR  quoted version string, e.g. "0.0.0.0"

#include <windows.h>

#ifndef RC_APP_VERSION
#define RC_APP_VERSION 0,0,0,0
#endif
#ifndef RC_APP_VERSION_STR
#define RC_APP_VERSION_STR "0.0.0.0"
#endif

IDI_ICON1 ICON "pencil2d.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     RC_APP_VERSION
PRODUCTVERSION  RC_APP_VERSION
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "JustAnimate"
            VALUE "FileDescription",  "JustAnimate"
            VALUE "FileVersion",      RC_APP_VERSION_STR
            VALUE "InternalName",     "justanimate"
            VALUE "LegalCopyright",   "GNU General Public License, version 2"
            VALUE "OriginalFilename", "justanimate.exe"
            VALUE "ProductName",      "JustAnimate"
            VALUE "ProductVersion",   RC_APP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
